# Cloudflare Pages / Discord OAuth Configuration Example
# Cloudflare Pagesの「設定 > 開発 > 環境変数」に登録する項目です。

# Discord Developer Portalで作成したアプリケーションの Client ID
DISCORD_CLIENT_ID=1234567890123456789

# Discord Developer Portalで取得した Client Secret (秘密鍵)
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# 対象とする Discord サーバー (ギルド) の ID
DISCORD_GUILD_ID=1234567890123456789

# リダイレクトURI (Cloudflare PagesのドメインURL + /api/auth/discord/callback)
DISCORD_REDIRECT_URI=https://your-app.pages.dev/api/auth/discord/callback
