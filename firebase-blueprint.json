{
  "entities": {
    "characters": {
      "title": "Character",
      "description": "Character in database",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "alignment": { "type": "string" },
        "powerLevel": { "type": "string" },
        "rank": { "type": "string" },
        "iconType": { "type": "string" },
        "iconValue": { "type": "string" },
        "firstPerson": { "type": "string" },
        "catchphrase": { "type": "string" },
        "favoriteFood": { "type": "string" },
        "specialMove": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "isCustom": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "alignment", "powerLevel", "rank", "iconType", "iconValue", "features", "createdAt"]
    }
  },
  "firestore": {
    "rules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /characters/{characterId} {\n      allow read, write: if true;\n    }\n  }\n}",
    "indexes": []
  }
}
